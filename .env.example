# BotFather'dan alınan token
TELEGRAM_TOKEN=
# Virgülle ayrılmış chat ID'ler. Boş bırakıp bota yazarsan ID'ni söyler.
ALLOWED_CHAT_IDS=
# Fiyat kontrol aralığı (saniye)
POLL_SECONDS=30
# Aynı seviyeye tekrar bildirim için fiyatın uzaklaşması gereken mesafe (EM cinsinden)
REARM_EM=0.25
# CHoCH/BOS swing tespiti: tepe/dip, iki yanındaki kaç mumdan yüksek/düşük olmalı
SWING_LEN=2
# Sabah haber bildirimi saati (Türkiye saati) ve para birimleri (virgülle, ALL = hepsi)
NEWS_HOUR=8
NEWS_CURRENCIES=USD,EUR
# Haberden kaç dakika önce hatırlatma gelsin (0 = kapalı)
NEWS_REMIND_MINUTES=5
# Açıklanan haber sonuçları için Financial Modeling Prep API anahtarı (boşsa sonuç gönderilmez)
FMP_API_KEY=
